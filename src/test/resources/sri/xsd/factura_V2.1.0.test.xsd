<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <xsd:element name="factura">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="infoTributaria" type="xsd:anyType"/>
        <xsd:element name="infoFactura" type="xsd:anyType"/>
        <xsd:element name="detalles" type="xsd:anyType"/>
        <xsd:element name="infoAdicional" type="xsd:anyType" minOccurs="0"/>
      </xsd:sequence>
      <xsd:attribute name="id" use="required" fixed="comprobante"/>
      <xsd:attribute name="version" use="required" fixed="2.1.0"/>
    </xsd:complexType>
  </xsd:element>
</xsd:schema>
